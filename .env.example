# MongoDB Configuration
# Opção 1: MongoDB Atlas (Recomendado para produção)
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/daily-quest-db?retryWrites=true&w=majority

# Opção 2: MongoDB Local (Desenvolvimento)
MONGODB_URI=mongodb://localhost:27017/daily-quest-db

# Opção 3: MongoDB Local com autenticação
# MONGODB_URI=mongodb://admin:password@localhost:27017/daily-quest-db?authSource=admin

# IMPORTANTE: Se sua senha contém caracteres especiais, faça URL encoding
# Exemplo: @ → %40, : → %3A, / → %2F
# Veja o guia completo em: MONGODB_SETUP.md

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=1d

# Application
PORT=3000
NODE_ENV=development
